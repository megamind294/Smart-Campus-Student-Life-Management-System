FROM golang:1.24-bookworm AS builder
ARG MINIO_REF=RELEASE.2025-09-07T16-13-09Z
WORKDIR /src
RUN git clone --depth 1 --branch "$MINIO_REF" https://github.com/minio/minio.git . \
    && git rev-parse HEAD > /minio-source-commit.txt
RUN CGO_ENABLED=0 GOMAXPROCS=2 go build -p 2 -trimpath -o /out/minio .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/minio /usr/local/bin/minio
COPY --from=builder /src/LICENSE /usr/share/doc/minio/LICENSE
COPY --from=builder /minio-source-commit.txt /usr/share/doc/minio/source-commit.txt
EXPOSE 9000 9001
ENTRYPOINT ["/usr/local/bin/minio"]
